# Dockerfile.Dev

FROM mcr.microsoft.com/dotnet/sdk:10.0

# Install essential tools
RUN apt-get update && \
    apt-get install -y \
    curl \
    git \
    unzip \
    jq \
    ripgrep \
    make \
    less \
    tree \
    zip \
    procps \
    supervisor \
    iproute2 \
    iputils-ping \
    netcat-openbsd \
    dnsutils \
    traceroute \
    ca-certificates \
    gnupg \
    lsb-release \
    postgresql-client \
    redis-tools \
    docker.io && \
    rm -rf /var/lib/apt/lists/*

# Install Node.js (useful for tooling if needed)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install Azure CLI
RUN curl -sL https://aka.ms/InstallAzureCLIDeb | bash

# Install GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && \
    apt-get install -y gh && \
    rm -rf /var/lib/apt/lists/*

# Install cloc (optional)
RUN curl -fsSL https://raw.githubusercontent.com/AlDanial/cloc/master/cloc -o /usr/local/bin/cloc && \
    chmod 0755 /usr/local/bin/cloc

# Install Azure Functions Core Tools v4 for local Function App execution.
RUN curl -sL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor > microsoft.gpg && \
    mv microsoft.gpg /etc/apt/trusted.gpg.d/microsoft.gpg && \
    echo "deb [arch=$(dpkg --print-architecture)] https://packages.microsoft.com/debian/12/prod bookworm main" \
    > /etc/apt/sources.list.d/azure-functions-core-tools.list && \
    apt-get update && \
    apt-get install -y azure-functions-core-tools-4 && \
    rm -rf /var/lib/apt/lists/*

# Install Azurite for AzureWebJobsStorage during local Functions runs.
RUN npm install -g azurite

COPY .devcontainer/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

WORKDIR /workspace

CMD ["/usr/bin/supervisord", "-n"]
