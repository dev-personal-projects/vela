{
  "Supabase": {
    "Url": "https://<project-ref>.supabase.co",
    "AnonKey": "<supabase-anon-key>",
    "JwtSecret": "<supabase-jwt-secret>"
  },
  "ConnectionStrings": {
    "Default": "postgresql://<user>:<password>@<host>:6543/postgres"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
