{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/finance-tracker-graphql.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/finance-tracker-graphql.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/finance-tracker-graphql.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "prepare commit context",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/git/prepare-commit-context.sh"
            ],
            "problemMatcher": []
        },
        {
            "label": "finalize commit",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/scripts/git/finalize-commit.sh"
            ],
            "problemMatcher": []
        }
    ]
}
