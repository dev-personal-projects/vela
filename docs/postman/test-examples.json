{
  "info": {
    "title": "Finance Tracker API — Test Examples",
    "description": "Every request shows the exact method, URL, headers and body. Auth uses REST endpoints. Everything else uses GraphQL.",
    "baseUrl_local": "http://localhost:8080",
    "baseUrl_production": "https://your-app.azurewebsites.net",
    "note": "Replace <JWT_TOKEN> with the accessToken returned from Sign In"
  },

  "requests": [

    {
      "id": 1,
      "name": "Health Check",
      "description": "Public GET — no token needed. Used by load balancers and monitoring tools.",
      "method": "GET",
      "url": "http://localhost:8080/health",
      "headers": {},
      "body": null,
      "expected_response": {
        "status": 200,
        "body": {
          "status": "healthy",
          "service": "Finance Tracker API",
          "timestamp": "2025-01-15T00:00:00Z"
        }
      }
    },

    {
      "id": 2,
      "name": "Sign Up",
      "description": "REST POST — creates a new user. Returns accessToken and refreshToken immediately when email confirmation is disabled in Supabase.",
      "method": "POST",
      "url": "http://localhost:8080/api/auth/signup",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "email": "user@example.com",
        "password": "Password123!"
      },
      "expected_response": {
        "status": 201,
        "body": {
          "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "tokenType": "bearer"
        }
      }
    },

    {
      "id": 3,
      "name": "Sign Up — Invalid Email",
      "description": "Should return 400 with a validation error.",
      "method": "POST",
      "url": "http://localhost:8080/api/auth/signup",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "email": "notanemail",
        "password": "Password123!"
      },
      "expected_response": {
        "status": 400,
        "body": {
          "error": "A valid email address is required."
        }
      }
    },

    {
      "id": 4,
      "name": "Sign Up — Short Password",
      "description": "Should return 400 with a validation error.",
      "method": "POST",
      "url": "http://localhost:8080/api/auth/signup",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "email": "user@example.com",
        "password": "123"
      },
      "expected_response": {
        "status": 400,
        "body": {
          "error": "Password must be at least 8 characters."
        }
      }
    },

    {
      "id": 5,
      "name": "Sign Up — Email Already Exists",
      "description": "Should return 400 with a clear duplicate error.",
      "method": "POST",
      "url": "http://localhost:8080/api/auth/signup",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "email": "user@example.com",
        "password": "Password123!"
      },
      "expected_response": {
        "status": 400,
        "body": {
          "error": "An account with this email already exists."
        }
      }
    },

    {
      "id": 6,
      "name": "Sign In",
      "description": "REST POST — returns accessToken and refreshToken. Copy the accessToken for all GraphQL requests.",
      "method": "POST",
      "url": "http://localhost:8080/api/auth/signin",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "email": "user@example.com",
        "password": "Password123!"
      },
      "expected_response": {
        "status": 200,
        "body": {
          "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "refreshToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
          "tokenType": "bearer"
        }
      }
    },

    {
      "id": 7,
      "name": "Sign In — Wrong Password",
      "description": "Should return 401 with a clear error.",
      "method": "POST",
      "url": "http://localhost:8080/api/auth/signin",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "email": "user@example.com",
        "password": "wrongpassword"
      },
      "expected_response": {
        "status": 401,
        "body": {
          "error": "Incorrect email or password."
        }
      }
    },

    {
      "id": 8,
      "name": "Sign In — User Not Found",
      "description": "Should return 401 with a clear error.",
      "method": "POST",
      "url": "http://localhost:8080/api/auth/signin",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "email": "nobody@example.com",
        "password": "Password123!"
      },
      "expected_response": {
        "status": 401,
        "body": {
          "error": "Incorrect email or password."
        }
      }
    },

    {
      "id": 9,
      "name": "Protected Query — No Token",
      "description": "GraphQL POST — should be rejected with auth error.",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "query": "{ incomes { id amount } }"
      },
      "expected_response": {
        "status": 200,
        "body": {
          "errors": [
            {
              "message": "The current user is not authorized to access this resource."
            }
          ]
        }
      }
    },

    {
      "id": 10,
      "name": "Add Income",
      "description": "GraphQL POST — requires JWT. Adds an income record.",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <JWT_TOKEN>"
      },
      "body": {
        "query": "mutation { addIncome(input: { amount: 5000.00, source: \"Salary\", description: \"Monthly salary\", date: \"2025-01-15T00:00:00Z\" }) { income { id amount source description date } errors } }"
      },
      "expected_response": {
        "status": 200,
        "body": {
          "data": {
            "addIncome": {
              "income": {
                "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                "amount": 5000.00,
                "source": "Salary",
                "description": "Monthly salary",
                "date": "2025-01-15T00:00:00Z"
              },
              "errors": null
            }
          }
        }
      }
    },

    {
      "id": 11,
      "name": "Add Income — Negative Amount",
      "description": "Should return validation error in the payload.",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <JWT_TOKEN>"
      },
      "body": {
        "query": "mutation { addIncome(input: { amount: -100, source: \"Salary\", description: \"\", date: \"2025-01-15T00:00:00Z\" }) { income { id } errors } }"
      },
      "expected_response": {
        "status": 200,
        "body": {
          "data": {
            "addIncome": {
              "income": null,
              "errors": ["Amount must be greater than 0."]
            }
          }
        }
      }
    },

    {
      "id": 12,
      "name": "Add Income — Future Date",
      "description": "Should return validation error in the payload.",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <JWT_TOKEN>"
      },
      "body": {
        "query": "mutation { addIncome(input: { amount: 1000, source: \"Bonus\", description: \"\", date: \"2099-01-01T00:00:00Z\" }) { income { id } errors } }"
      },
      "expected_response": {
        "status": 200,
        "body": {
          "data": {
            "addIncome": {
              "income": null,
              "errors": ["Date cannot be in the future."]
            }
          }
        }
      }
    },

    {
      "id": 13,
      "name": "Get All Incomes",
      "description": "GraphQL POST — requires JWT. Returns all income records for the user.",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <JWT_TOKEN>"
      },
      "body": {
        "query": "{ incomes { id amount source description date } }"
      },
      "expected_response": {
        "status": 200,
        "body": {
          "data": {
            "incomes": [
              {
                "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
                "amount": 5000.00,
                "source": "Salary",
                "description": "Monthly salary",
                "date": "2025-01-15T00:00:00Z"
              }
            ]
          }
        }
      }
    },

