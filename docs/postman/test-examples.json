      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": {
        "Content-Type": "application/json",
        "Authorization": "Bearer <JWT_TOKEN>"
      },
      "body": {
        "query": "mutation { recordRepayment(input: { loanId: \"<LOAN_ID>\", amount: 999999.00 }) { loan { id } errors } }"
