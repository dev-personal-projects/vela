{
  "info": {
    "title": "Finance Tracker API — Postman Test Examples",
    "baseUrl": "http://localhost:8080",
    "instructions": [
      "Step 1 — Run the app: dotnet run",
      "Step 2 — Sign In (request 6) to get your JWT token",
      "Step 3 — Copy the accessToken from the Sign In response",
      "Step 4 — Paste it as: Authorization: Bearer <accessToken>",
      "Step 5 — Run requests in the testing_order below"
    ],
    "note": "Always copy the id from an Add or GetAll response before running GetById, Update, or Delete"
  },

  "requests": [

    {
      "id": 1,
      "name": "Health Check",
      "method": "GET",
      "url": "http://localhost:8080/health",
      "headers": {},
      "body": null,
      "expected_response": { "status": 200, "body": { "status": "healthy", "service": "Finance Tracker API" } }
    },

    {
      "id": 2,
      "name": "Sign Up",
      "method": "POST",
      "url": "http://localhost:8080/api/auth/signup",
      "headers": { "Content-Type": "application/json" },
      "body": { "email": "user@example.com", "password": "Password123!" },
      "expected_response": { "status": 201, "body": { "message": "Account created successfully. Please sign in." } }
    },

    {
      "id": 3,
      "name": "Sign Up — Invalid Email",
      "method": "POST",
      "url": "http://localhost:8080/api/auth/signup",
      "headers": { "Content-Type": "application/json" },
      "body": { "email": "notanemail", "password": "Password123!" },
      "expected_response": { "status": 400, "body": { "error": "A valid email address is required." } }
    },

    {
      "id": 4,
      "name": "Sign Up — Short Password",
      "method": "POST",
      "url": "http://localhost:8080/api/auth/signup",
      "headers": { "Content-Type": "application/json" },
      "body": { "email": "user@example.com", "password": "123" },
      "expected_response": { "status": 400, "body": { "error": "Password must be at least 8 characters." } }
    },

    {
      "id": 5,
      "name": "Sign Up — Email Already Exists",
      "method": "POST",
      "url": "http://localhost:8080/api/auth/signup",
      "headers": { "Content-Type": "application/json" },
      "body": { "email": "user@example.com", "password": "Password123!" },
      "expected_response": { "status": 400, "body": { "error": "An account with this email already exists." } }
    },

    {
      "id": 6,
      "name": "Sign In",
      "description": "Copy the accessToken for all GraphQL requests below.",
      "method": "POST",
      "url": "http://localhost:8080/api/auth/signin",
      "headers": { "Content-Type": "application/json" },
      "body": { "email": "user@example.com", "password": "Password123!" },
      "expected_response": {
        "status": 200,
        "body": { "accessToken": "eyJhbGci...", "refreshToken": "", "tokenType": "bearer" }
      }
    },

    {
      "id": 7,
      "name": "Sign In — Wrong Password",
      "method": "POST",
      "url": "http://localhost:8080/api/auth/signin",
      "headers": { "Content-Type": "application/json" },
      "body": { "email": "user@example.com", "password": "wrongpassword" },
      "expected_response": { "status": 401, "body": { "error": "Incorrect email or password." } }
    },

    {
      "id": 8,
      "name": "Protected Query — No Token",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": { "Content-Type": "application/json" },
      "body": { "query": "{ incomes { id amount } }" },
      "expected_response": {
        "status": 401,
        "body": { "errors": [{ "message": "The current user is not authorized to access this resource.", "extensions": { "code": "AUTH_NOT_AUTHENTICATED" } }] }
      }
    },

    {
      "id": 9,
      "name": "Add Income",
      "description": "Copy the id from the response for GetById, Update, Delete.",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": { "Content-Type": "application/json", "Authorization": "Bearer <JWT_TOKEN>" },
      "body": {
        "query": "mutation { addIncome(input: { amount: 5000.00, source: \"Salary\", description: \"Monthly salary\", date: \"2025-01-15T00:00:00Z\" }) { income { id amount source description date } message errors } }"
      },
      "expected_response": {
        "status": 200,
        "body": { "data": { "addIncome": { "income": { "id": "<uuid>", "amount": 5000.00, "source": "Salary", "description": "Monthly salary", "date": "2025-01-15T00:00:00Z" }, "message": "Income added successfully.", "errors": null } } }
      }
    },

    {
      "id": 10,
      "name": "Get All Incomes",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": { "Content-Type": "application/json", "Authorization": "Bearer <JWT_TOKEN>" },
      "body": { "query": "{ incomes { id amount source description date } }" },
      "expected_response": {
        "status": 200,
        "body": { "data": { "incomes": [{ "id": "<uuid>", "amount": 5000.00, "source": "Salary", "description": "Monthly salary", "date": "2025-01-15T00:00:00Z" }] } }
      }
    },

    {
      "id": 11,
      "name": "Get Income By Id",
      "description": "Paste the id from Add Income or Get All Incomes.",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": { "Content-Type": "application/json", "Authorization": "Bearer <JWT_TOKEN>" },
      "body": { "query": "{ income(id: \"<PASTE_ID>\") { id amount source description date } }" },
      "expected_response": {
        "status": 200,
        "body": { "data": { "income": { "id": "<uuid>", "amount": 5000.00, "source": "Salary", "description": "Monthly salary", "date": "2025-01-15T00:00:00Z" } } }
      }
    },

    {
      "id": 12,
      "name": "Get Income By Id — Not Found",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": { "Content-Type": "application/json", "Authorization": "Bearer <JWT_TOKEN>" },
      "body": { "query": "{ income(id: \"00000000-0000-0000-0000-000000000000\") { id amount } }" },
      "expected_response": { "status": 200, "body": { "data": { "income": null } } }
    },

    {
      "id": 13,
      "name": "Update Income",
      "description": "Paste the id from Add Income. Updates amount, source, description and date.",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": { "Content-Type": "application/json", "Authorization": "Bearer <JWT_TOKEN>" },
      "body": {
        "query": "mutation { updateIncome(input: { id: \"<PASTE_ID>\", amount: 5500.00, source: \"Salary\", description: \"Monthly salary - updated\", date: \"2025-01-15T00:00:00Z\" }) { income { id amount source description date } message errors } }"
      },
      "expected_response": {
        "status": 200,
        "body": { "data": { "updateIncome": { "income": { "id": "<uuid>", "amount": 5500.00, "source": "Salary", "description": "Monthly salary - updated", "date": "2025-01-15T00:00:00Z" }, "message": "Income updated successfully.", "errors": null } } }
      }
    },

    {
      "id": 14,
      "name": "Update Income — Not Found",
      "description": "Should return error when id does not exist.",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": { "Content-Type": "application/json", "Authorization": "Bearer <JWT_TOKEN>" },
      "body": {
        "query": "mutation { updateIncome(input: { id: \"00000000-0000-0000-0000-000000000000\", amount: 1000, source: \"Test\", description: \"\", date: \"2025-01-15T00:00:00Z\" }) { income { id } message errors } }"
      },
      "expected_response": {
        "status": 200,
        "body": { "data": { "updateIncome": { "income": null, "errors": ["Income record not found."] } } }
      }
    },

    {
      "id": 15,
      "name": "Delete Income",
      "description": "Paste the id from Add Income. Returns success: true on success.",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": { "Content-Type": "application/json", "Authorization": "Bearer <JWT_TOKEN>" },
      "body": { "query": "mutation { deleteIncome(id: \"<PASTE_ID>\") { success message errors } }" },
      "expected_response": {
        "status": 200,
        "body": { "data": { "deleteIncome": { "success": true, "message": "Income deleted successfully.", "errors": null } } }
      }
    },

    {
      "id": 16,
      "name": "Delete Income — Not Found",
      "description": "Should return error when id does not exist.",
      "method": "POST",
      "url": "http://localhost:8080/graphql",
      "headers": { "Content-Type": "application/json", "Authorization": "Bearer <JWT_TOKEN>" },
      "body": { "query": "mutation { deleteIncome(id: \"00000000-0000-0000-0000-000000000000\") { success message errors } }" },
      "expected_response": {
        "status": 200,
        "body": { "data": { "deleteIncome": { "success": false, "errors": ["Income record not found."] } } }
      }
    },

