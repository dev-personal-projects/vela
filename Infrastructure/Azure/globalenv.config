# globalenv.config
#
# Shared Azure deployment configuration for the Vela API.
# This file contains non-secret deployment identifiers only. Runtime secrets
# such as database credentials, Supabase keys, Redis credentials, and JWT
# signing material must stay in Azure Key Vault.

# ========== Common ==========

ENVIRONMENT_PREFIX=dev
LOG_FOLDER=logs

# ========== Azure account ==========

TENANT_ID=7d20ca84-8064-4008-9ddb-bf9216c87c7b
GLOBAL_INFRA_SUBSCRIPTION_ID=9b93ac7e-4e02-4852-90e9-3b5fab34c960
PROJECT_SUBSCRIPTION_ID=9b93ac7e-4e02-4852-90e9-3b5fab34c960

# ========== Regional defaults ==========

EUROPE_LOCATION=northeurope
EUROPE_PREFIX=neu

# ========== Vela project ==========

PROJECT_NAME=vela
PROJECT_PREFIX=vela
WORKLOAD_NAME=vela-api
RESOURCE_INSTANCE=001
PROJECT_LOCATION=northeurope
PROJECT_RESOURCE_GROUP=rg-vela-dev-neu
PROJECT_INTERNAL_DNS_SUFFIX=vela.internal

# ========== Azure Functions ==========

FUNCTION_APP_NAME=func-vela-api-dev-neu-001
FUNCTION_STORAGE_ACCOUNT_NAME=stvelafuncdevneu001
FUNCTIONS_RUNTIME=dotnet-isolated
FUNCTIONS_RUNTIME_VERSION=10.0
FUNCTIONS_VERSION=4

# ========== Observability ==========

LOG_ANALYTICS_WORKSPACE_NAME=log-vela-api-dev-neu-001
LOG_ANALYTICS_RETENTION_DAYS=30
LOG_ANALYTICS_DAILY_QUOTA_GB=0.5
APPLICATION_INSIGHTS_NAME=appi-vela-api-dev-neu-001
APPLICATION_INSIGHTS_TYPE=web

# ========== Azure Key Vault ==========

KEY_VAULT_NAME=kv-vela-dev-neu
KEY_VAULT_URI=https://kv-vela-dev-neu.vault.azure.net/

# ========== GitHub deployment automation ==========

GITHUB_REPO=https://github.com/dev-personal-projects/vela
GITHUB_BRANCH=main
