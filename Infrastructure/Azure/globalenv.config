# globalenv.config
#
# Shared Azure deployment configuration for the Finance Tracker GraphQL API.
# This file contains non-secret deployment identifiers only. Runtime secrets
# such as database credentials, Supabase keys, Redis credentials, and JWT
# signing material must stay in Azure Key Vault.

# ========== Common ==========

ENVIRONMENT_PREFIX=dev
LOG_FOLDER=logs

# ========== Azure account ==========

TENANT_ID=7d20ca84-8064-4008-9ddb-bf9216c87c7b
GLOBAL_INFRA_SUBSCRIPTION_ID=9b93ac7e-4e02-4852-90e9-3b5fab34c960
PROJECT_SUBSCRIPTION_ID=9b93ac7e-4e02-4852-90e9-3b5fab34c960

# ========== Regional defaults ==========

EUROPE_LOCATION=northeurope
EUROPE_PREFIX=neu

# ========== Finance Tracker project ==========

PROJECT_NAME=finance-tracker
PROJECT_PREFIX=fintrack
PROJECT_LOCATION=northeurope
PROJECT_RESOURCE_GROUP=rg-finance-tracker-dev-neu
PROJECT_INTERNAL_DNS_SUFFIX=finance-tracker.internal

# ========== Azure Container Apps ==========

ACR_NAME=acrfintrackdevneu
CONTAINER_APP_NAME=ca-finance-tracker-dev-neu
CONTAINER_APP_ENV_NAME=cae-finance-tracker-dev-neu
CONTAINER_TARGET_PORT=8080
IMAGE_NAME=finance-tracker-api
IMAGE_TAG=latest

# ========== Azure Key Vault ==========

KEY_VAULT_NAME=kv-fintrack-dev-neu
KEY_VAULT_URI=https://kv-fintrack-dev-neu.vault.azure.net/

# ========== GitHub deployment automation ==========

GITHUB_REPO=https://github.com/dev-personal-projects/finance-tracker-graphql
GITHUB_BRANCH=main

